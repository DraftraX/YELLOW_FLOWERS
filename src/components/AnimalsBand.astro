---

<div class="contenedor-animalitos">
  {activeAnimals.map((animal, idx) => (
    <div 
      class="tarjeta-animal" 
      role="button" 
      tabindex="0" 
      aria-label={`${animal.name}: ${animal.msg}`}
      style={`animation-delay: ${idx * 0.2}s`}
    >
      <div class="globo-dialogo">
        <span>{animal.msg}</span>
      </div>
      <div class="icono-animal-svg" set:html={ANIMAL_SVGS[animal.id] || ANIMAL_SVGS.gato}></div>
      <span class="nombre-animal">{animal.name}</span>
    </div>
  ))}
</div>

<style>
  .contenedor-animalitos {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: 35px;
  }

  .tarjeta-animal {
    position: relative;
    width: 96px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: animMecerAnimal 3s ease-in-out infinite;
  }

  @keyframes animMecerAnimal {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .tarjeta-animal:hover {
    transform: scale(1.18) translateY(-12px);
  }

  .icono-animal-svg {
    width: 82px;
    height: 82px;
    filter: drop-shadow(0 6px 8px rgba(0,0,0,0.18));
  }

  .nombre-animal {
    font-size: 0.8rem;
    font-weight: 800;
    margin-top: 6px;
    opacity: 0.9;
  }

  .globo-dialogo {
    position: absolute;
    bottom: 108%;
    left: 50%;
    transform: translateX(-50%) scale(0);
    background: #FFF;
    border: 2px solid var(--color-primary);
    border-radius: 16px;
    padding: 8px 14px;
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--marron-osc);
    white-space: normal;
    width: max-content;
    max-width: min(220px, 80vw);
    text-align: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.16);
    z-index: 30;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
    opacity: 0;
  }

  .globo-dialogo::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 7px solid transparent;
    border-top-color: var(--color-primary);
  }

  :global(.globo-dialogo.activo) {
    transform: translateX(-50%) scale(1) !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  @media (max-width: 650px) {
    .contenedor-animalitos { gap: 14px; }
    .tarjeta-animal { width: 72px; }
    .icono-animal-svg { width: 62px; height: 62px; }
    .globo-dialogo { font-size: 0.8rem; padding: 6px 10px; }
  }
</style>

<script>
  function setupAnimals() {
    const cards = document.querySelectorAll('.tarjeta-animal');
    let activeBubbleTimer: any = null;

    function closeAllAnimalBubbles() {
      if (activeBubbleTimer) clearTimeout(activeBubbleTimer);
      document.querySelectorAll('.globo-dialogo.activo').forEach(b => {
        b.classList.remove('activo');
      });
    }

    // 1. Cerrar la nube de mensaje al tocar en cualquier otra parte de la pantalla
    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.tarjeta-animal')) {
        closeAllAnimalBubbles();
      }
    });

    // Soporte para pantallas táctiles (móviles)
    document.addEventListener('touchend', (e: TouchEvent) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.tarjeta-animal')) {
        closeAllAnimalBubbles();
      }
    }, { passive: true });

    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        e.stopPropagation();
        const bubble = card.querySelector('.globo-dialogo');
        const wasActive = bubble?.classList.contains('activo');

        // 2. Cerrar cualquier otro animalito que estuviera abierto
        closeAllAnimalBubbles();

        // 3. Si no estaba abierto, abrir este
        if (bubble && !wasActive) {
          bubble.classList.add('activo');
          activeBubbleTimer = setTimeout(() => {
            bubble.classList.remove('activo');
          }, 4500);

          // Corazoncito flotante
          const rect = card.getBoundingClientRect();
          const heart = document.createElement('div');
          heart.textContent = '💛';
          heart.style.cssText = `
            position: fixed;
            left: ${rect.left + rect.width / 2}px;
            top: ${rect.top}px;
            font-size: 22px;
            z-index: 99999;
            pointer-events: none;
            animation: animHeart 1.2s ease-out forwards;
          `;
          document.body.appendChild(heart);
          setTimeout(() => heart.remove(), 1200);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupAnimals);
</script>
